From 25064378e25668c711a1bcb44fe8800810dfd681 Mon Sep 17 00:00:00 2001
From: Michael McAllister <me@michaelmcallister.org>
Date: Sun, 11 Oct 2026 20:16:10 +0100
Subject: [PATCH] Broadcast sensor availability to clients before they claim a
 sensor

A desktop may create its D-Bus proxy while discovery is still running. It caches HasAccelerometer=false and waits for that property to change before claiming the sensor. Notify such clients when discovery or hotplug makes a sensor available; keep measurements restricted to claimants.

Add an integration test covering cached availability on an unclaimed proxy during device addition and removal.

Assisted-by: OpenAI GPT-6
Signed-off-by: Michael McAllister <me@michaelmcallister.org>
---
 src/iio-sensor-proxy.c    | 33 ++++++++++++++++++++++++++-------
 tests/integration-test.py | 23 +++++++++++++++++++++++
 2 files changed, 49 insertions(+), 7 deletions(-)

diff --git a/src/iio-sensor-proxy.c b/src/iio-sensor-proxy.c
index 9c7e8cd..e532b88 100644
--- a/src/iio-sensor-proxy.c
+++ b/src/iio-sensor-proxy.c
@@ -240,8 +240,6 @@ send_dbus_event_for_client (SensorData     *data,
 	GVariantBuilder props_builder;
 	GVariant *props_changed = NULL;
 
-	g_return_if_fail (destination_bus_name != NULL);
-
 	g_variant_builder_init (&props_builder, G_VARIANT_TYPE ("a{sv}"));
 
 	if (mask & PROP_HAS_ACCELEROMETER) {
@@ -252,10 +250,10 @@ send_dbus_event_for_client (SensorData     *data,
 				       g_variant_new_boolean (has_accel));
 
 		/* Send the orientation when the device appears */
-		if (has_accel) {
+		if (has_accel && destination_bus_name) {
 			mask |= PROP_ACCELEROMETER_ORIENTATION;
 			mask |= PROP_ACCELEROMETER_TILT;
-                } else {
+                } else if (!has_accel) {
 			data->previous_orientation = ORIENTATION_UNDEFINED;
 			data->previous_tilt = TILT_UNDEFINED;
 		}
@@ -279,7 +277,7 @@ send_dbus_event_for_client (SensorData     *data,
 				       g_variant_new_boolean (has_als));
 
 		/* Send the light level when the device appears */
-		if (has_als)
+		if (has_als && destination_bus_name)
 			mask |= PROP_LIGHT_LEVEL;
 	}
 
@@ -298,7 +296,7 @@ send_dbus_event_for_client (SensorData     *data,
 				       g_variant_new_boolean (has_compass));
 
 		/* Send the heading when the device appears */
-		if (has_compass)
+		if (has_compass && destination_bus_name)
 			mask |= PROP_COMPASS_HEADING;
 	}
 
@@ -315,7 +313,7 @@ send_dbus_event_for_client (SensorData     *data,
 				       g_variant_new_boolean (has_proximity));
 
 		/* Send proximity information when the device appears */
-		if (has_proximity)
+		if (has_proximity && destination_bus_name)
 			mask |= PROP_PROXIMITY_NEAR;
 	}
 
@@ -349,6 +347,27 @@ send_dbus_event (SensorData     *data,
 	g_assert (data->connection);
 	g_assert ((mask & PROP_ALL) == 0 || (mask & PROP_ALL_COMPASS) == 0);
 
+	/* Availability must reach clients that have not claimed a sensor yet.
+	 * Otherwise a desktop which first observes HasAccelerometer=false never
+	 * learns that discovery or hotplug has made it available. Measurements
+	 * remain directed only to clients which claimed the relevant sensor. */
+	const PropertiesMask availability_mask = PROP_HAS_ACCELEROMETER |
+		PROP_HAS_AMBIENT_LIGHT | PROP_HAS_PROXIMITY | PROP_HAS_COMPASS;
+	PropertiesMask changed_availability = mask & availability_mask;
+
+	if (changed_availability) {
+		send_dbus_event_for_client (data, NULL, changed_availability);
+		for (i = 0; i < NUM_SENSOR_TYPES; i++) {
+			PropertiesMask sensor_mask = mask_for_sensor_type (i);
+
+			if ((sensor_mask & changed_availability) && driver_type_exists (data, i))
+				mask |= sensor_mask & ~availability_mask;
+		}
+		mask &= ~availability_mask;
+	}
+	if (!mask)
+		return;
+
 	/* Make a list of the events each client for each sensor
 	 * is interested in */
 	ht = g_hash_table_new (g_str_hash, g_str_equal);
diff --git a/tests/integration-test.py b/tests/integration-test.py
index 23bf623..e5647ce 100755
--- a/tests/integration-test.py
+++ b/tests/integration-test.py
@@ -370,6 +370,29 @@ class Tests(dbusmock.DBusTestCase):
         self.assertEqual(self.get_dbus_property('HasAccelerometer'), False)
         self.stop_daemon()
 
+    def test_unclaimed_sensor_availability(self):
+        """A cached proxy sees hotplug without first claiming the sensor."""
+        # Keep the daemon running before the accelerometer is present.
+        self.testbed.add_device('platform', 'hwmon-als', None,
+            ['light', '(128,128)'], ['IIO_SENSOR_PROXY_TYPE', 'hwmon-als'])
+        self.start_daemon()
+        self.assertFalse(self.proxy.get_cached_property('HasAccelerometer').unpack())
+        changes = []
+        self.proxy.connect('g-properties-changed',
+                           lambda proxy, changed, invalidated: changes.append(changed.unpack()))
+        accel = self.testbed.add_device('iio', 'iio-accel', None,
+            ['in_accel_x_raw', '0', 'in_accel_y_raw', '-25.6',
+             'in_accel_z_raw', '0', 'in_accel_scale', '10',
+             'sampling_frequency', '5.2', 'name', 'IIO Test Accelerometer'],
+            ['NAME', '"IIO Accelerometer"', 'IIO_SENSOR_PROXY_TYPE', 'iio-poll-accel'])
+        self.testbed.uevent(accel, 'add')
+        self.assertEventually(lambda: self.proxy.get_cached_property('HasAccelerometer').unpack())
+        self.assertTrue(any(c.get('HasAccelerometer') is True for c in changes))
+        self.assertFalse(any('AccelerometerOrientation' in c for c in changes))
+        self.testbed.uevent(accel, 'remove')
+        self.assertEventually(lambda: not self.proxy.get_cached_property('HasAccelerometer').unpack())
+        self.assertTrue(any(c.get('HasAccelerometer') is False for c in changes))
+
     def test_iio_poll_accel(self):
         '''iio poll accel'''
         accel = self.testbed.add_device('iio', 'iio-accel', None,
