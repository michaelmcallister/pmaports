aa19169d7c399f94ce0519ba09ce5c1fd00596e413827bb6885bb440d7e4676f6113661b1e95e4cdb97c281dd938c1aaa5cb4dbeded087506c67789b1294f6de  0001-motorola-capri-display.patch
