From 6641b0fabb901c959be4e6e4cfbace1fe1e84b56 Mon Sep 17 00:00:00 2001
From: Michael McAllister <me@michaelmcallister.org>
Date: Sun, 11 Oct 2026 20:24:46 +0100
Subject: [PATCH] Load active-slot firmware and modern SSC sensor registries

Select the active A/B metadata slot when mapping dynamic partitions. Mount ext filesystems without journal replay and make a read-only runtime copy of the modern SSC registry for unprivileged FastRPC services. Keep the original Android partition contents and permissions unchanged.

Assisted-by: OpenAI GPT-6
Signed-off-by: Michael McAllister <me@michaelmcallister.org>
---
 msm-firmware-loader.sh | 67 ++++++++++++++++++++++++++++++++++++------
 tests/firmware.sh      | 47 +++++++++++++++++++++++++++++
 2 files changed, 105 insertions(+), 9 deletions(-)
 create mode 100644 tests/firmware.sh

diff --git a/msm-firmware-loader.sh b/msm-firmware-loader.sh
index 9ff9a59..308afce 100644
--- a/msm-firmware-loader.sh
+++ b/msm-firmware-loader.sh
@@ -30,6 +30,52 @@ ab_get_slot() {
 	echo "$ab_slot_suffix"
 }
 
+# Keep journal replay disabled when inspecting Android ext filesystems.
+mount_firmware_partition() {
+	local options="ro,nodev,noexec,nosuid"
+	case "$(blkid -s TYPE -o value "$1")" in
+		ext3|ext4) options="$options,noload" ;;
+	esac
+	mount -o "$options" "$1" "$2"
+}
+
+map_dynamic_partitions() {
+	case "$(ab_get_slot)" in
+		_a) make-dynpart-mappings "$1" 0 ;;
+		_b) make-dynpart-mappings "$1" 1 ;;
+		*) make-dynpart-mappings "$1" ;;
+	esac
+}
+
+# Modern SSC firmware uses a directory of registry files instead of sns.reg.
+# Copy it into /run so unprivileged FastRPC services can read Android-owned
+# calibration without changing persist's ownership or writing to the partition.
+setup_sensor_registry() {
+	local registry="$BASEDIR/mnt/persist/sensors/registry/registry"
+	local config
+	config="$BASEDIR/mnt/vendor$(ab_get_slot)/etc/sensors/sns_reg_config"
+	local target="$BASEDIR/target/qcom/sensors"
+	if [ -d "$registry" ] && [ ! -e "$target/registry" ]; then
+		mkdir -p "$target"
+		cp -R "$registry" "$target/registry"
+		chmod -R a=rX "$target/registry"
+	fi
+	if [ -f "$config" ] && [ ! -e "$target/sns_reg.conf" ]; then
+		mkdir -p "$target"
+		ln -s "$config" "$target/sns_reg.conf"
+	fi
+}
+
+# Match whole partition names: "sp" must not match a listed "dsp_b".
+is_listed_partition() {
+	local partition="$1" candidate
+	shift
+	for candidate do
+		[ "$partition" != "$candidate" ] || return 0
+	done
+	return 1
+}
+
 # Configurations:
 
 # List of partitions to be mounted and inspected for blobs.
@@ -58,6 +104,7 @@ BASEDIR="/run/msm-firmware-loader"
 # may not be available yet. Since this script only creates symlinks, it
 # uses tmpfs to work around the early-run limitations as well as to reduce
 # disk wear slightly.
+mkdir -p "$BASEDIR"
 mount -o mode=755,nodev,noexec,nosuid -t tmpfs none "$BASEDIR"
 
 mkdir -p "$BASEDIR/mnt"
@@ -78,20 +125,21 @@ then
 		DEVNAME="$(grep DEVNAME "$part"/uevent | sed 's/DEVNAME=//g')"
 		PARTNAME="$(grep PARTNAME "$part"/uevent | sed 's/PARTNAME=//g')"
 
-		if [ -z "${SUPER_PARTITIONS##*"$PARTNAME"*}" ] && [ -n "$PARTNAME" ]
+		# shellcheck disable=SC2086 # Whitespace-separated partition list.
+		if is_listed_partition "$PARTNAME" $SUPER_PARTITIONS
 		then
 			# system is for retrofit targets, not all devices may be
 			# retrofit, in which case make-dynpart-mappings will fail.
-			if ! make-dynpart-mappings "/dev/$DEVNAME"; then continue; fi;
+			if ! map_dynamic_partitions "/dev/$DEVNAME"; then continue; fi;
 
 			for dynpart in /dev/mapper/*
 			do
 				PARTNAME="$(basename "$dynpart")"
-				if [ -z "${FW_PARTITIONS##*"$PARTNAME"*}" ] && [ -n "$PARTNAME" ]
+				# shellcheck disable=SC2086 # Whitespace-separated partition list.
+				if is_listed_partition "$PARTNAME" $FW_PARTITIONS
 				then
 					mkdir -p "$BASEDIR/mnt/$PARTNAME"
-					mount -o ro,nodev,noexec,nosuid \
-						"$dynpart" "$BASEDIR/mnt/$PARTNAME"
+					mount_firmware_partition "$dynpart" "$BASEDIR/mnt/$PARTNAME"
 				fi
 			done
 
@@ -108,11 +156,11 @@ do
 	DEVNAME="$(grep DEVNAME "$part"/uevent | sed 's/DEVNAME=//g')"
 	PARTNAME="$(grep PARTNAME "$part"/uevent | sed 's/PARTNAME=//g')"
 
-	if [ -z "${FW_PARTITIONS##*"$PARTNAME"*}" ] && [ -n "$PARTNAME" ] && [ ! -d "$BASEDIR/mnt/$PARTNAME" ]
+	# shellcheck disable=SC2086 # Whitespace-separated partition list.
+	if is_listed_partition "$PARTNAME" $FW_PARTITIONS && [ ! -d "$BASEDIR/mnt/$PARTNAME" ]
 	then
 		mkdir -p "$BASEDIR/mnt/$PARTNAME"
-		mount -o ro,nodev,noexec,nosuid \
-			"/dev/$DEVNAME" "$BASEDIR/mnt/$PARTNAME"
+		mount_firmware_partition "/dev/$DEVNAME" "$BASEDIR/mnt/$PARTNAME"
 	fi
 done
 
@@ -159,6 +207,8 @@ do
 	done
 done
 
+setup_sensor_registry
+
 # Check for sns.reg in persist partition
 if [ -f "$BASEDIR"/mnt/persist/sensors/sns.reg ]
 then
@@ -255,4 +305,3 @@ fi
 
 # Set the new custom firmware path:
 printf "%s" "$BASEDIR/target" > /sys/module/firmware_class/parameters/path
-
diff --git a/tests/firmware.sh b/tests/firmware.sh
new file mode 100644
index 0000000..a4dc4de
--- /dev/null
+++ b/tests/firmware.sh
@@ -0,0 +1,47 @@
+#!/bin/sh
+# SPDX-License-Identifier: MIT
+set -eu
+source_dir=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
+tmp=$(mktemp -d)
+trap 'chmod -R u+w "$tmp"; rm -rf "$tmp"' EXIT
+# Load just the functions; the production entry point must not run in tests.
+sed '/^# Configurations:/,$d' "$source_dir/msm-firmware-loader.sh" > "$tmp/functions"
+. "$tmp/functions"
+is_listed_partition dsp_b modem_b dsp_b persist
+is_listed_partition vendor_b vendor_b
+! is_listed_partition sp modem_b dsp_b persist
+! is_listed_partition vendor vendor_b
+! is_listed_partition '' modem_b dsp_b persist
+ab_get_slot() { printf '%s\n' "$slot"; }
+# shellcheck disable=SC3033 # BusyBox ash supports mocking this command name.
+make-dynpart-mappings() { printf '%s\n' "$*"; }
+for slot in _a _b ''; do
+ case "$slot" in _a) expected='/dev/super 0';; _b) expected='/dev/super 1';; '') expected='/dev/super';; esac
+ test "$(map_dynamic_partitions /dev/super)" = "$expected"
+done
+blkid() { printf '%s\n' "$filesystem"; }
+mount() { printf '%s\n' "$*"; }
+for filesystem in ext4 ext3 vfat; do
+ options='ro,nodev,noexec,nosuid'
+ case "$filesystem" in ext*) options="$options,noload";; esac
+ test "$(mount_firmware_partition /dev/vendor /mnt/vendor)" = "-o $options /dev/vendor /mnt/vendor"
+done
+BASEDIR="$tmp/firmware"
+slot=_b
+mkdir -p "$BASEDIR/mnt/persist/sensors/registry/registry" "$BASEDIR/mnt/vendor_b/etc/sensors"
+printf 'private calibration\n' > "$BASEDIR/mnt/persist/sensors/registry/registry/calibration"
+printf 'vendor sensor config\n' > "$BASEDIR/mnt/vendor_b/etc/sensors/sns_reg_config"
+chmod 600 "$BASEDIR/mnt/persist/sensors/registry/registry/calibration"
+setup_sensor_registry
+cmp "$BASEDIR/mnt/persist/sensors/registry/registry/calibration" "$BASEDIR/target/qcom/sensors/registry/calibration"
+test "$(stat -c %a "$BASEDIR/target/qcom/sensors/registry/calibration")" = 444
+test "$(stat -c %a "$BASEDIR/mnt/persist/sensors/registry/registry/calibration")" = 600
+cmp "$BASEDIR/mnt/vendor_b/etc/sensors/sns_reg_config" "$BASEDIR/target/qcom/sensors/sns_reg.conf"
+setup_sensor_registry
+test ! -e "$BASEDIR/target/qcom/sensors/registry/registry"
+# Devices with no modern registry remain supported.
+BASEDIR="$tmp/no-sensors"
+mkdir "$BASEDIR"
+setup_sensor_registry
+test ! -e "$BASEDIR/target"
+echo 'Firmware slot selection, read-only mounts and sensor registry tests passed'
