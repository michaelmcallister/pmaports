#!/bin/sh
# SPDX-License-Identifier: MIT
# The stock modem firmware hands GPIO100/101 to LPASS before ADSP starts.
set -eu

tr '\000' '\n' </proc/device-tree/compatible | grep -qx motorola,capri

# Defer the auto-booting ADSP while the PAS module registers the modem.
adsp=/sys/bus/platform/devices/a400000.remoteproc
test ! -e "$adsp/driver"
printf '%s\n' capri-wait-for-modem >"$adsp/driver_override"
modprobe ath10k_snoc
modprobe qcom_q6v5_pas

modem=
for attempt in $(seq 1 10); do
	for node in /sys/class/remoteproc/remoteproc*; do
		[ -r "$node/name" ] || continue
		if [ "$(cat "$node/name")" = modem ]; then
			modem=$node
			break
		fi
	done
	[ -z "$modem" ] || break
	sleep 1
done
test -n "$modem"
[ "$(cat "$modem/state")" != offline ] || echo start >"$modem/state"

# WLAN registration confirms that modem firmware initialization has completed.
for attempt in $(seq 1 45); do
	[ ! -d /sys/class/net/wlan0 ] || break
	sleep 1
done
test -d /sys/class/net/wlan0
printf '\n' >"$adsp/driver_override"
printf '%s\n' a400000.remoteproc >/sys/bus/platform/drivers/qcom_q6v5_pas/bind

for attempt in $(seq 1 20); do
	for node in /sys/class/remoteproc/remoteproc*; do
		[ -r "$node/name" ] || continue
		if [ "$(cat "$node/name")" = adsp ] && [ "$(cat "$node/state")" = running ]; then
			exit 0
		fi
	done
	sleep 1
done
echo 'ADSP firmware did not reach the running state' >&2
exit 1
