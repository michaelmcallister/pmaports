# SSC supplies Android display coordinates after applying the saved registry
# orientation. iio-sensor-proxy expects opposite X/Y signs for screen rotation.
# Keep positive Z for face-up tilt (verified from stationary physical readings).
SUBSYSTEM=="misc", KERNEL=="fastrpc-adsp", ENV{ACCEL_MOUNT_MATRIX}="-1, 0, 0; 0, -1, 0; 0, 0, 1"
