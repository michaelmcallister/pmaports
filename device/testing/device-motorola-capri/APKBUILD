# Reference: https://nura.eco/devicepkg
maintainer="Michael McAllister <me@michaelmcallister.org>"
pkgname=device-motorola-capri
pkgver=1
pkgrel=0
pkgdesc="Motorola Moto G10"
url="https://nura.eco"
license="MIT AND BSD-3-Clause"
arch="aarch64"
options="!check !archcheck"
depends="
	alsa-ucm-conf>=1.2.16.1-r1
	bluez-btmgmt
	boot-deploy>=0.25.0-r1
	firmware-motorola-capri
	glib
	hexagonrpcd>=0.4.0
	iio-sensor-proxy>=3.9-r3
	kmod
	libssc>=0.4.4-r1
	linux-motorola-capri
	android-tools-mkbootimg
	postmarketos-base
	postmarketos-mkinitfs>=2.12.0-r1
	python3
	qbootctl
	rmtfs
	swclock-offset>=0.3.0-r1
	tqftpserv
"
depends_openrc="
	$pkgname=$pkgver-r$pkgrel
	openrc
	postmarketos-base-openrc
	hexagonrpcd-openrc
	iio-sensor-proxy-openrc
	rmtfs-openrc
	msm-firmware-loader-openrc
	swclock-offset-openrc
	tqftpserv-openrc
	qbootctl-openrc
"
depends_systemd="
	$pkgname=$pkgver-r$pkgrel
	postmarketos-base-systemd>=92-r1
	hexagonrpcd-systemd
	iio-sensor-proxy-systemd
	qbootctl-systemd
	rmtfs-systemd
	msm-firmware-loader-systemd
	swclock-offset-systemd
	tqftpserv-systemd
"
makedepends="devicepkg-dev"
install="$pkgname-openrc.post-install $pkgname-openrc.post-upgrade"
subpackages="
	$pkgname-doc
	$pkgname-openrc
	$pkgname-phosh
	$pkgname-systemd
	$pkgname-udev
"
source="
	deviceinfo
	kernel-cmdline.conf
	modprobe.conf
	firmware.files
	81-libssc-motorola-capri.rules
	99-capri-mainline-input.rules
	capri-bluetooth
	capri-bluetooth.initd
	capri-hardware
	capri-hardware.initd
	capri-watchdog.initd
	rmtfs.confd
	hexagonrpcd-adsp-sensorspd.confd
	iio-sensor-proxy.confd
	50-capri.gschema.override
	phoc.ini
	capri-hardware.service
	capri-bluetooth.service
	rmtfs-systemd.conf
	hexagonrpcd-systemd.conf
	iio-sensor-proxy-systemd.conf
	watchdog-systemd.conf
	80-device-motorola-capri.preset
	README.md
	firmware.md
"

build() {
	devicepkg_build "$startdir" "$pkgname"
}

package() {
	devicepkg_package "$startdir" "$pkgname"
	install -Dm644 "$srcdir"/firmware.files \
		"$pkgdir"/usr/share/mkinitfs/files/20-capri-firmware.files
	for name in capri-hardware capri-bluetooth; do
		install -Dm755 "$srcdir/$name" "$pkgdir/usr/libexec/$name"
	done
	for name in capri-hardware capri-bluetooth capri-watchdog; do
		install -Dm755 "$srcdir/$name.initd" "$pkgdir/etc/init.d/$name"
	done
	for name in rmtfs hexagonrpcd-adsp-sensorspd iio-sensor-proxy; do
		install -Dm644 "$srcdir/$name.confd" "$pkgdir/etc/conf.d/$name"
	done
	install -Dm644 "$srcdir"/capri-hardware.service "$srcdir"/capri-bluetooth.service \
		-t "$pkgdir"/usr/lib/systemd/system
	for name in rmtfs iio-sensor-proxy; do
		install -Dm644 "$srcdir/$name-systemd.conf" \
			"$pkgdir/usr/lib/systemd/system/$name.service.d/motorola-capri.conf"
	done
	install -Dm644 "$srcdir"/hexagonrpcd-systemd.conf \
		"$pkgdir"/usr/lib/systemd/system/hexagonrpcd-adsp-sensorspd.service.d/motorola-capri.conf
	install -Dm644 "$srcdir"/watchdog-systemd.conf \
		"$pkgdir"/usr/lib/systemd/system.conf.d/50-motorola-capri.conf
	install -Dm644 "$srcdir"/80-device-motorola-capri.preset \
		-t "$pkgdir"/usr/lib/systemd/system-preset
	install -Dm644 "$srcdir"/*.rules -t "$pkgdir"/usr/lib/udev/rules.d
	install -Dm644 "$srcdir"/README.md "$srcdir"/firmware.md \
		-t "$pkgdir/usr/share/doc/$pkgname"
}

openrc() {
	replaces="rmtfs-openrc hexagonrpcd-openrc iio-sensor-proxy-openrc"
	default_openrc
}

phosh() {
	pkgdesc="Phosh hardware defaults for Motorola Moto G10"
	depends="$pkgname=$pkgver-r$pkgrel"
	install_if="$pkgname=$pkgver-r$pkgrel postmarketos-ui-phosh"
	replaces="phosh"
	install -Dm644 "$srcdir"/phoc.ini "$subpkgdir"/usr/share/phosh/phoc.ini
	install -Dm644 "$srcdir"/50-capri.gschema.override \
		"$subpkgdir"/usr/share/glib-2.0/schemas/50-capri.gschema.override
}

