# Forked from Alpine to handle sensors registered after the SSC registry becomes available.
# Contributor: Dylan Van Assche <dylan@postmarketos.org>
maintainer="Michael McAllister <me@michaelmcallister.org>"
pkgname=libssc
pkgver=0.4.4
pkgrel=1
pkgdesc="Library to expose Qualcomm Sensor Core sensors"
url="https://codeberg.org/DylanVanAssche/libssc"
arch="all"
license="GPL-3.0-or-later"
makedepends="
	eudev-dev
	glib-dev
	libgudev-dev
	linux-headers
	libqmi-dev
	meson
	protobuf-c-dev
	protobuf-dev
	python3-dev
	py3-gobject3
	py3-protobuf
	qrtr-libs
"
subpackages="$pkgname-dbg $pkgname-dev $pkgname-pyc"
builddir="$srcdir/$pkgname"
source="
	$pkgname-$pkgver.tar.gz::https://codeberg.org/DylanVanAssche/libssc/archive/v$pkgver.tar.gz
	0001-upstream-clear-signal-handler.patch
	0002-upstream-discovery-timeout.patch
	0003-upstream-test-exit-status.patch
	0004-retry-sensor-discovery.patch
"

# Tests suddenly fail on s390x, disable them for now
case "$CARCH" in
	s390x) options="!check";;
esac

build() {
	abuild-meson \
		-Db_lto=true \
		. output
	meson compile -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

check() {
	meson test --print-errorlogs -C output
}

