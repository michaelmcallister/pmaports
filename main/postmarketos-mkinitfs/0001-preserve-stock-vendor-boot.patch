diff --git a/internal/archive/archive.go b/internal/archive/archive.go
index 088ce17..98996ad 100644
--- a/internal/archive/archive.go
+++ b/internal/archive/archive.go
@@ -54,6 +54,13 @@ type Archive struct {
 	destPrefixes    map[string]string
 }
 
+var usrMergeLinks = []struct{ name, target string }{
+	{"bin", "usr/bin"},
+	{"sbin", "usr/bin"},
+	{"lib", "usr/lib"},
+	{"usr/sbin", "bin"},
+}
+
 func New(format CompressFormat, level CompressLevel) *Archive {
 	buf := new(bytes.Buffer)
 	archive := &Archive{
@@ -72,12 +79,7 @@ func New(format CompressFormat, level CompressLevel) *Archive {
 
 	// Add usr-merged symlinks first
 	archive.addDir("usr")
-	for _, s := range []struct{ name, target string }{
-		{"bin", "usr/bin"},
-		{"sbin", "usr/bin"},
-		{"lib", "usr/lib"},
-		{"usr/sbin", "bin"},
-	} {
+	for _, s := range usrMergeLinks {
 		archive.items.add(archiveItem{
 			header: &cpio.Header{
 				Name:     s.name,
@@ -90,6 +92,46 @@ func New(format CompressFormat, level CompressLevel) *Archive {
 	return archive
 }
 
+// ExpandUsrMergeAliases replaces the top-level usr-merge symlinks with copies
+// of their target directories. A bootloader may prepend a vendor ramdisk that
+// already contains e.g. lib/modules. Linux cannot replace a non-empty directory
+// with a symlink when unpacking our archive, leaving the dynamic loader missing
+// from /lib. Keep the canonical /usr paths and provide the legacy paths too.
+// Call this after adding all files and before writing the archive.
+func (archive *Archive) ExpandUsrMergeAliases() {
+	archive.items.Lock()
+	defer archive.items.Unlock()
+
+	var expanded archiveItems
+	for _, item := range archive.items.items {
+		alias := false
+		for _, link := range usrMergeLinks {
+			if item.header.Name == link.name {
+				alias = true
+				break
+			}
+		}
+		if !alias {
+			expanded.add(item)
+		}
+	}
+	for _, link := range usrMergeLinks {
+		expanded.add(archiveItem{header: &cpio.Header{
+			Name: link.name,
+			Mode: 0755 | cpio.TypeDir,
+		}})
+		target := filepath.Join(filepath.Dir(link.name), link.target)
+		for _, item := range archive.items.items {
+			if strings.HasPrefix(item.header.Name, target+"/") {
+				header := *item.header
+				header.Name = link.name + strings.TrimPrefix(header.Name, target)
+				expanded.add(archiveItem{header: &header, sourcePath: item.sourcePath})
+			}
+		}
+	}
+	archive.items.items = expanded.items
+}
+
 type archiveItem struct {
 	header     *cpio.Header
 	sourcePath string
diff --git a/internal/archive/vendor_ramdisk_test.go b/internal/archive/vendor_ramdisk_test.go
new file mode 100644
index 0000000..2c2211e
--- /dev/null
+++ b/internal/archive/vendor_ramdisk_test.go
@@ -0,0 +1,87 @@
+// Copyright 2026 Michael McAllister
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+package archive
+
+import (
+	"io"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/cavaliergopher/cpio"
+)
+
+func TestVendorRamdiskDirectoryCompatibility(t *testing.T) {
+	for _, expand := range []bool{false, true} {
+		name := "usr-merged"
+		if expand {
+			name = "vendor-ramdisk"
+		}
+		t.Run(name, func(t *testing.T) {
+			dir := t.TempDir()
+			source := filepath.Join(dir, "payload")
+			if err := os.WriteFile(source, []byte("payload"), 0755); err != nil {
+				t.Fatal(err)
+			}
+			ar := New(FormatNone, LevelDefault)
+			for _, dest := range []string{"/lib/ld-musl-aarch64.so.1", "/bin/sh", "/sbin/udevd"} {
+				if err := ar.AddItem(source, dest); err != nil {
+					t.Fatal(err)
+				}
+			}
+			if expand {
+				ar.ExpandUsrMergeAliases()
+			}
+			output := filepath.Join(dir, "initramfs")
+			if err := ar.Write(output, 0644); err != nil {
+				t.Fatal(err)
+			}
+			f, err := os.Open(output)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer f.Close()
+			reader := cpio.NewReader(f)
+			headers := map[string]*cpio.Header{}
+			contents := map[string]string{}
+			for {
+				header, err := reader.Next()
+				if err == io.EOF {
+					break
+				}
+				if err != nil {
+					t.Fatal(err)
+				}
+				data, err := io.ReadAll(reader)
+				if err != nil {
+					t.Fatal(err)
+				}
+				headers[header.Name] = header
+				contents[header.Name] = string(data)
+			}
+			for _, alias := range []string{"bin", "sbin", "lib", "usr/sbin"} {
+				header := headers[alias]
+				if header == nil {
+					t.Fatalf("missing directory alias %q", alias)
+				}
+				if expand {
+					if !header.Mode.IsDir() || header.Linkname != "" {
+						t.Errorf("%q cannot overlay an existing vendor directory: %+v", alias, header)
+					}
+				} else if header.Mode&cpio.TypeSymlink == 0 || header.Linkname == "" {
+					t.Errorf("default archive should retain symlink %q", alias)
+				}
+			}
+			paths := []string{"usr/lib/ld-musl-aarch64.so.1", "usr/bin/sh", "usr/bin/udevd"}
+			if expand {
+				paths = append(paths, "lib/ld-musl-aarch64.so.1", "bin/sh", "sbin/udevd", "usr/sbin/udevd")
+			}
+			for _, path := range paths {
+				if contents[path] != "payload" {
+					t.Errorf("missing payload at %q", path)
+				}
+			}
+		})
+	}
+}
