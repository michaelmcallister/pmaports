4c7bdc20168aa97a39d2c1127a6390db89e2a74bbe33542b1aaf3f97eaca35876995b065c05a66c8d6915b355d20396df2e1191dee6e52d6a354fa9ef6d4401d  config-motorola-capri.aarch64
"
