+func TestPreserveVendorBootOverride(t *testing.T) {
+	var devinfo DeviceInfo
+	path := filepath.Join(t.TempDir(), "deviceinfo")
+	for _, value := range []string{"true", "false"} {
+		config := "deviceinfo_format_version=\"0\"\ndeviceinfo_bootimg_preserve_vendor_boot=\"" + value + "\"\n"
+		if err := os.WriteFile(path, []byte(config), 0644); err != nil {
+			t.Fatal(err)
+		}
+		if err := devinfo.ReadDeviceinfo(path); err != nil {
+			t.Fatal(err)
+		}
+		if devinfo.BootimgPreserveVendorBoot != (value == "true") {
+			t.Fatalf("preserve_vendor_boot override %q was not applied", value)
+		}
+	}
+}
